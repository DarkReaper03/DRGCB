# =============================================
# Unified Bot — Configuration Template
# Copy this to .env and fill in your values
# NEVER commit .env to git
# =============================================

# Bot token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Bot application/client ID
CLIENT_ID=your_client_id_here

# Your Discord user ID (owner-only commands)
OWNER_ID=your_discord_user_id_here

# Your private test guild ID (/hiddenmsg registered here only)
PRIVATE_GUILD_ID=your_private_server_id_here

# Webhook URL for /hiddenmsg (optional)
WEBHOOK_URL=your_webhook_url_here

# Comma-separated list of guild IDs for instant command registration
GUILD_IDS=123456789,987654321

# Lavalink v4 connection (music)
LAVALINK_HOST=your.lavalink.hostname
LAVALINK_PORT=4001
LAVALINK_PASSWORD=your_lavalink_password
LAVALINK_SECURE=true
